Attribute VB_Name = "TrimmerSelfTest"
' The trimmer's self-test (designs/stage-B-trimmer.md 4.10.4).
' RunSelfTest is the "Self-test" button. RunSelfTestWithCanary also runs the canary case, whose
' expected listing is wrong on purpose, to show that a failure is reported.
' Each case is filled into a new hidden workbook from TrimmerTestData (generated by the Kotlin
' reference model), trimmed by Trimmer.TrimSheet, written out as a listing (4.10.2) and compared
' with the case's expected text. The expectations come only from TrimmerTestData; nothing here
' works out what the result should be. Each case's workbook is closed without saving.
Option Explicit

Private Const CANARY_CASE As String = "canary"
Private Const BIG_CASE As String = "big"
Private Const MAX_DETAIL_LINES As Long = 5
Private Const SEP As String = " | "
Private Const TICK As String = "[ ]"
Private Const LISTED_COLS As Long = 7
Private Const BOX_TITLE As String = "Trimmer self-test"

Public Sub RunSelfTest()
    ShowResult SelfTestResult(False)
End Sub

Public Sub RunSelfTestWithCanary()
    ShowResult SelfTestResult(True)
End Sub

' The result in a box: the lines above, and the whole text in the box's field, already
' selected, for Ctrl+C (owner's answer 1a, SB.5).
Private Sub ShowResult(ByVal text As String)
    Dim shown As String
    shown = text
    If Len(shown) > 900 Then shown = Left$(shown, 900) & " ..."
    InputBox shown & vbLf & vbLf & "Press Ctrl+C to copy the line below, then OK.", BOX_TITLE, Replace(text, vbLf, " / ")
End Sub

' Runs every case (the canary too when includeCanary) and gives the summary line, then up to
' five lines naming the first differing line of each failing case.
Public Function SelfTestResult(ByVal includeCanary As Boolean) As String
    Dim i As Long, total As Long, passed As Long, failedNames As String, details As String
    Dim detail As String, nDetails As Long, seconds As Double, bigSeconds As Double, ok As Boolean
    Dim canaryRan As Boolean, canaryPassed As Boolean, savedWas As Boolean, head As String

    savedWas = ThisWorkbook.Saved
    bigSeconds = -1
    For i = 1 To TrimmerTestData.CaseCount()
        If TrimmerTestData.CaseName(i) <> CANARY_CASE Or includeCanary Then
            detail = ""
            ok = RunCase(i, detail, seconds)
            If ok And ThisWorkbook.Saved <> savedWas Then
                ok = False
                detail = TrimmerTestData.CaseName(i) & ": the trimmer file was changed"
            End If
            If TrimmerTestData.CaseName(i) = BIG_CASE Then bigSeconds = seconds
            If TrimmerTestData.CaseName(i) = CANARY_CASE Then
                canaryRan = True
                canaryPassed = ok
            Else
                total = total + 1
                If ok Then
                    passed = passed + 1
                Else
                    failedNames = failedNames & IIf(failedNames = "", "", ", ") & TrimmerTestData.CaseName(i)
                    If nDetails < MAX_DETAIL_LINES Then
                        details = details & vbLf & detail
                        nDetails = nDetails + 1
                    End If
                End If
            End If
        End If
    Next i

    If canaryRan And canaryPassed Then
        SelfTestResult = "TRIMMER BROKEN: canary passed"
        Exit Function
    End If
    If passed = total Then
        head = "TRIMMER PASS(" & total & ")"
        If bigSeconds >= 0 Then head = head & " big=" & SecondsText(bigSeconds)
    Else
        head = "TRIMMER FAIL(" & passed & "/" & total & "): " & failedNames
    End If
    If canaryRan Then head = head & " canary=FAIL (as it should)"
    SelfTestResult = head & details
End Function

' One case: True when the result (or message) is the expected one and the case's own sheets
' are unchanged. detail names the first difference otherwise.
Private Function RunCase(ByVal i As Long, ByRef detail As String, ByRef seconds As Double) As Boolean
    Dim wb As Workbook, ws As Worksheet, rs As Worksheet, message As String, actual As String
    Dim expected As String, before As Collection, sheetsBefore As Long, caseName As String, t As Double

    caseName = TrimmerTestData.CaseName(i)
    On Error GoTo Failed
    Set wb = Workbooks.Add(xlWBATWorksheet)
    ShowWorkbook wb, False
    Set ws = wb.Worksheets(1)
    TrimmerTestData.FillCase i, ws
    Set before = Snapshot(wb, Nothing)
    sheetsBefore = wb.Worksheets.Count

    t = Timer
    Set rs = Trimmer.TrimSheet(ws, True, message)
    seconds = Timer - t
    If seconds < 0 Then seconds = seconds + 86400

    If rs Is Nothing Then
        actual = message
        If wb.Worksheets.Count <> sheetsBefore Then detail = caseName & ": a tab was added although the trim stopped"
    Else
        actual = Listing(rs)
        If wb.Worksheets.Count <> sheetsBefore + 1 Then detail = caseName & ": the tab count went from " & sheetsBefore & " to " & wb.Worksheets.Count
    End If
    If detail = "" Then detail = SnapshotDifference(before, Snapshot(wb, rs), caseName)

    expected = TrimmerTestData.CaseExpected(i)
    If detail = "" And caseName = BIG_CASE And Not rs Is Nothing Then
        actual = BlockSummary(actual)
        detail = PairingProblem(rs)
    End If
    If detail = "" And actual <> expected Then detail = FirstDifference(caseName, expected, actual)
    RunCase = (detail = "")
    GoTo Done

Failed:
    detail = caseName & ": error " & Err.Number & " " & Err.Description
    RunCase = False
    Resume Done
Done:
    On Error Resume Next
    If Not wb Is Nothing Then
        ShowWorkbook wb, True
        wb.Close SaveChanges:=False
    End If
    On Error GoTo 0
End Function

' Hides (or shows again) the case's workbook's windows. Only windows whose workbook has wb's
' name: LibreOffice lists every open window under wb.Windows. The window is shown again before
' the workbook is closed: LibreOffice breaks when a workbook with a hidden window is closed.
Private Sub ShowWorkbook(ByVal wb As Workbook, ByVal visible As Boolean)
    Dim w As Window
    On Error Resume Next
    For Each w In wb.Windows
        If w.Parent.Name = wb.Name Then w.Visible = visible
    Next w
    On Error GoTo 0
End Sub

' ---------------------------------------------------------------------------------------------
' The listing (4.10.2)
' ---------------------------------------------------------------------------------------------

' One line per row of the result tab, row 1 first: cells A to G joined by " | ", then ROWS <n>
' with the number of vehicle rows (rows with a tick box in C).
Private Function Listing(ByVal rs As Worksheet) As String
    Dim lastRow As Long, r As Long, c As Long, line As String, cellText As String, vehicles As Long
    Dim parts() As String, n As Long

    lastRow = LastRowOf(rs, LISTED_COLS)
    ReDim parts(1 To lastRow + 1)
    For r = 1 To lastRow
        line = ""
        For c = 1 To LISTED_COLS
            cellText = ListedCell(rs.Cells(r, c), c)
            If c = 3 And cellText = TICK Then vehicles = vehicles + 1
            line = line & IIf(c = 1, "", SEP) & cellText
        Next c
        n = n + 1
        parts(n) = line & vbLf
    Next r
    n = n + 1
    parts(n) = "ROWS " & vehicles & vbLf
    Listing = Join(parts, "")
End Function

' A cell as the listing writes it: empty is nothing, text as is, a number in its shortest form
' followed by {format} unless General; an empty cell of C or F with a thin border on all four
' sides is "[ ]".
Private Function ListedCell(ByVal cell As Range, ByVal col As Long) As String
    Dim v As Variant, fmt As String
    v = cell.Value
    If IsEmpty(v) Then
        If (col = 3 Or col = 6) And HasFourThinBorders(cell) Then ListedCell = TICK
    ElseIf IsError(v) Then
        ListedCell = "#ERROR"
    ElseIf VarType(v) = vbString Then
        ListedCell = v
    ElseIf VarType(v) = vbBoolean Then
        ListedCell = CStr(v)
    Else
        ListedCell = Shortest(CDbl(v))
        fmt = cell.NumberFormat
        If fmt <> "General" Then ListedCell = ListedCell & " {" & fmt & "}"
    End If
End Function

Private Function HasFourThinBorders(ByVal cell As Range) As Boolean
    Dim edges As Variant, i As Long
    edges = Array(xlEdgeLeft, xlEdgeTop, xlEdgeBottom, xlEdgeRight)
    For i = 0 To 3
        If cell.Borders(edges(i)).LineStyle = xlNone Then Exit Function
        If cell.Borders(edges(i)).Weight <> xlThin Then Exit Function
    Next i
    HasFourThinBorders = True
End Function

' The shortest decimal form: "." as the point, no thousands separator, no exponent.
Private Function Shortest(ByVal d As Double) As String
    Dim s As String, sign As String, mant As String, ex As Long, p As Long, digits As String, pointAt As Long
    s = Trim$(Str$(d))
    If Left$(s, 1) = "-" Then
        sign = "-"
        s = Mid$(s, 2)
    End If
    p = InStr(1, s, "E", vbTextCompare)
    If p > 0 Then
        mant = Left$(s, p - 1)
        ex = CLng(Mid$(s, p + 1))
    Else
        mant = s
    End If
    p = InStr(mant, ".")
    If p > 0 Then
        digits = Left$(mant, p - 1) & Mid$(mant, p + 1)
        pointAt = p - 1 + ex
    Else
        digits = mant
        pointAt = Len(mant) + ex
    End If
    If pointAt <= 0 Then
        digits = String$(1 - pointAt, "0") & digits
        pointAt = 1
    ElseIf pointAt > Len(digits) Then
        digits = digits & String$(pointAt - Len(digits), "0")
    End If
    s = Left$(digits, pointAt)
    mant = Mid$(digits, pointAt + 1)
    Do While Len(mant) > 0 And Right$(mant, 1) = "0"
        mant = Left$(mant, Len(mant) - 1)
    Loop
    Do While Len(s) > 1 And Left$(s, 1) = "0"
        s = Mid$(s, 2)
    Loop
    If Len(mant) > 0 Then s = s & "." & mant
    If s = "0" Then sign = ""
    Shortest = sign & s
End Function

Private Function LastRowOf(ByVal ws As Worksheet, ByVal lastCol As Long) As Long
    Dim c As Long, r As Long
    LastRowOf = ws.UsedRange.Row + ws.UsedRange.Rows.Count - 1
    For c = 1 To lastCol
        r = ws.Cells(ws.Rows.Count, c).End(xlUp).Row
        If r > LastRowOf Then LastRowOf = r
    Next c
End Function

' The big case's listing as its CaseExpected has it: BLOCK <title> <vehicle rows> per block,
' then the ROWS line. A block starts at the row after row 2 or after an empty row.
Private Function BlockSummary(ByVal listingText As String) As String
    Dim lines() As String, i As Long, cells() As String, title As String, n As Long, out As String
    Dim emptyLine As String

    emptyLine = Replace(String$(LISTED_COLS - 1, "|"), "|", SEP)
    lines = Split(listingText, vbLf)
    For i = 2 To UBound(lines)
        If Left$(lines(i), 5) = "ROWS " Then
            If title <> "" Then out = out & "BLOCK " & title & " " & n & vbLf
            out = out & lines(i) & vbLf
            Exit For
        ElseIf lines(i) = emptyLine Then
            If title <> "" Then out = out & "BLOCK " & title & " " & n & vbLf
            title = ""
            n = 0
        Else
            cells = Split(lines(i), SEP)
            If title = "" Then
                title = cells(0)
            ElseIf UBound(cells) >= 2 Then
                If cells(2) = TICK Then n = n + 1
            End If
        End If
    Next i
    BlockSummary = out
End Function

' The big case (4.10.3): every vehicle row's description must still be
' "Car <Reg Number> m<Mileage> p<Selling Price in pence>", so a row split up is found.
Private Function PairingProblem(ByVal rs As Worksheet) As String
    Dim r As Long, lastRow As Long, want As String, reg As String, pence As Long
    lastRow = LastRowOf(rs, LISTED_COLS)
    For r = 2 To lastRow
        If HasFourThinBorders(rs.Cells(r, 3)) Then
            If IsEmpty(rs.Cells(r, 2).Value) Then reg = "" Else reg = CStr(rs.Cells(r, 2).Value)
            pence = CLng(Round(CDbl(rs.Cells(r, 5).Value) * 100, 0))
            want = "Car " & reg & " m" & Shortest(CDbl(rs.Cells(r, 4).Value)) & " p" & pence
            If CStr(rs.Cells(r, 1).Value) <> want Then
                PairingProblem = BIG_CASE & " row " & r & ": expected """ & want & """ got """ & CStr(rs.Cells(r, 1).Value) & """"
                Exit Function
            End If
        End If
    Next r
End Function

' "regs line 7: expected "..." got "...""
Private Function FirstDifference(ByVal caseName As String, ByVal expected As String, ByVal actual As String) As String
    Dim e() As String, a() As String, i As Long, n As Long, el As String, al As String
    e = Split(expected, vbLf)
    a = Split(actual, vbLf)
    n = UBound(e)
    If UBound(a) > n Then n = UBound(a)
    For i = 0 To n
        el = ""
        al = ""
        If i <= UBound(e) Then el = e(i)
        If i <= UBound(a) Then al = a(i)
        If el <> al Or i > UBound(e) Or i > UBound(a) Then
            FirstDifference = caseName & " line " & (i + 1) & ": expected """ & el & """ got """ & al & """"
            Exit Function
        End If
    Next i
    FirstDifference = caseName & ": differs"
End Function

Private Function SecondsText(ByVal seconds As Double) As String
    SecondsText = Replace(Format$(seconds, "0.0"), ",", ".") & "s"
End Function

' ---------------------------------------------------------------------------------------------
' The case's own sheets must be unchanged (4.2 step 4, 4.10.4)
' ---------------------------------------------------------------------------------------------

' Every worksheet of wb except skip, in order: its name, and the value and number format of
' every cell from A1 to the end of its used range.
Private Function Snapshot(ByVal wb As Workbook, ByVal skip As Worksheet) As Collection
    Dim shots As New Collection, sh As Worksheet
    For Each sh In wb.Worksheets
        If skip Is Nothing Then
            AddShot shots, sh
        ElseIf sh.Name <> skip.Name Then
            AddShot shots, sh
        End If
    Next sh
    Set Snapshot = shots
End Function

Private Sub AddShot(ByVal shots As Collection, ByVal sh As Worksheet)
    Dim lastRow As Long, lastCol As Long, vals As Variant, fmts() As String, r As Long, c As Long, one(1 To 1, 1 To 1) As Variant
    lastRow = sh.UsedRange.Row + sh.UsedRange.Rows.Count - 1
    lastCol = sh.UsedRange.Column + sh.UsedRange.Columns.Count - 1
    If lastRow = 1 And lastCol = 1 Then
        one(1, 1) = sh.Cells(1, 1).Value
        vals = one
    Else
        vals = sh.Range(sh.Cells(1, 1), sh.Cells(lastRow, lastCol)).Value
    End If
    ReDim fmts(1 To lastRow, 1 To lastCol)
    For r = 1 To lastRow
        For c = 1 To lastCol
            fmts(r, c) = sh.Cells(r, c).NumberFormat
        Next c
    Next r
    shots.Add Array(sh.Name, vals, fmts)
End Sub

Private Function SnapshotDifference(ByVal before As Collection, ByVal after As Collection, ByVal caseName As String) As String
    Dim i As Long, r As Long, c As Long, b As Variant, a As Variant
    If before.Count <> after.Count Then
        SnapshotDifference = caseName & ": the workbook had " & before.Count & " other tabs, now " & after.Count
        Exit Function
    End If
    For i = 1 To before.Count
        b = before(i)
        a = after(i)
        If b(0) <> a(0) Then
            SnapshotDifference = caseName & ": tab """ & b(0) & """ is now """ & a(0) & """"
            Exit Function
        End If
        If UBound(b(1), 1) <> UBound(a(1), 1) Or UBound(b(1), 2) <> UBound(a(1), 2) Then
            SnapshotDifference = caseName & ": tab """ & b(0) & """ changed size"
            Exit Function
        End If
        For r = 1 To UBound(b(1), 1)
            For c = 1 To UBound(b(1), 2)
                If Not SameValue(b(1)(r, c), a(1)(r, c)) Or b(2)(r, c) <> a(2)(r, c) Then
                    SnapshotDifference = caseName & ": tab """ & b(0) & """ cell row " & r & " column " & c & " changed"
                    Exit Function
                End If
            Next c
        Next r
    Next i
End Function

Private Function SameValue(ByVal x As Variant, ByVal y As Variant) As Boolean
    If VarType(x) <> VarType(y) Then Exit Function
    If IsEmpty(x) Then
        SameValue = True
    ElseIf IsError(x) Then
        SameValue = True
    Else
        SameValue = (x = y)
    End If
End Function
