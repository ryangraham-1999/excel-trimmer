' Adds a tab named tabName after the last sheet; found by its name not being there before (as 4.2 step 4).
Private Sub AddOldTab(ByVal wb As Workbook, ByVal tabName As String)
    Dim before As String, sh As Worksheet, found As Worksheet, n As Long, count As Long
    before = "|"
    For Each sh In wb.Worksheets
        before = before & sh.Name & "|"
    Next sh
    count = wb.Worksheets.Count
    wb.Worksheets.Add After:=wb.Worksheets(wb.Worksheets.Count)
    For Each sh In wb.Worksheets
        If InStr(1, before, "|" & sh.Name & "|", vbBinaryCompare) = 0 Then
            Set found = sh
            n = n + 1
        End If
    Next sh
    If n <> 1 Or wb.Worksheets.Count <> count + 1 Then Err.Raise vbObjectError + 513, , "could not add the tab " & tabName
    found.Name = tabName
    found.Cells(1, 1).Value = "Old tab " & tabName & ", left as it is"
End Sub

' The minimal standard generator (Park and Miller) by Schrage's method: every value fits a Long.
Private Function BigNext(ByRef s As Long) As Long
    Dim hi As Long, lo As Long, t As Long
    hi = s \ 127773
    lo = s Mod 127773
    t = 16807 * lo - 2836 * hi
    If t <= 0 Then t = t + 2147483647
    s = t
    BigNext = t
End Function

Private Function BigDisposal(ByVal k As Long) As String
    Select Case k
        Case 0: BigDisposal = "RETAIL"
        Case 1: BigDisposal = "DEMO"
        Case 2: BigDisposal = "Courtesy"
        Case 3: BigDisposal = "Auction"
        Case 4: BigDisposal = "Trade"
        Case 5: BigDisposal = "courtesy"
    End Select
End Function

' A reg from a pattern: L a capital letter, l a small letter, d a digit, anything else as is.
Private Function BigReg(ByRef s As Long) As String
    Dim pat As String, out As String, i As Long, ch As String
    Select Case BigNext(s) Mod 10
        Case 0: pat = ""
        Case 1: pat = "LLddLLL"
        Case 2: pat = "LLddLLL"
        Case 3: pat = "LLddLLL"
        Case 4: pat = "LLddLLL"
        Case 5: pat = "LLZ dddd"
        Case 6: pat = "LLZ dddd"
        Case 7: pat = "LLZ dddd"
        Case 8: pat = "LLZdddd"
        Case 9: pat = "llddlll"
    End Select
    For i = 1 To Len(pat)
        ch = Mid$(pat, i, 1)
        If ch = "L" Then
            out = out & Chr$(65 + BigNext(s) Mod 26)
        ElseIf ch = "l" Then
            out = out & Chr$(97 + BigNext(s) Mod 26)
        ElseIf ch = "d" Then
            out = out & Chr$(48 + BigNext(s) Mod 10)
        Else
            out = out & ch
        End If
    Next i
    BigReg = out
End Function
