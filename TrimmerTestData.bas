' ---- case 12: big ----
Private Sub Case_12(ws As Worksheet)
    Dim s As Long, r As Long, disp As String, reg As String, mileage As Long, pennies As Long
    ws.Cells(1, 1).Value = "Veh Description"
    ws.Cells(1, 2).Value = "Reg Number"
    ws.Cells(1, 3).Value = "Mileage"
    ws.Cells(1, 4).Value = "Selling Price"
    ws.Cells(1, 5).Value = "Disposal Method"
    s = BIG_SEED
    For r = 2 To BIG_ROWS + 1
        disp = BigDisposal(BigNext(s) Mod 6)
        reg = BigReg(s)
        mileage = BigNext(s) Mod 120001
        If BigNext(s) Mod 5 = 0 Then
            pennies = 0
        Else
            pennies = 500000 + BigNext(s) Mod 4000001
        End If
        ws.Cells(r, 1).Value = "Car " & reg & " m" & mileage & " p" & pennies
        If Len(reg) > 0 Then ws.Cells(r, 2).Value = reg
        ws.Cells(r, 3).Value = mileage
        ws.Cells(r, 4).NumberFormat = "#,##0.00"
        ws.Cells(r, 4).Value = pennies / 100
        ws.Cells(r, 5).Value = disp
    Next r
End Sub

